# Copy to .env and fill in. Never commit .env.

# Admin login password (username: admin). At least 8 characters.
# If unset, a random password is generated on first start and printed in the logs.
ADMIN_PASSWORD=change-me-please

# Signs session cookies. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, one is generated and stored next to the database (data volume).
SECRET_KEY=

# URL encoded in the login-page QR code, e.g. http://192.168.1.50:5000 or https://quiz.example.com
# Needed in Docker, where the app cannot see your LAN IP.
APP_URL=

# Let new players create an account by logging in with a new name (true/false).
ALLOW_REGISTRATION=true

# Set to true when serving over HTTPS (cookies are then only sent over HTTPS).
SESSION_COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik) that sets X-Forwarded-* headers.
TRUST_PROXY=false

# Host port for docker compose.
HOST_PORT=5000
